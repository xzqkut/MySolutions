<Window x:Class="WpfApp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WpfApp4.Converters"
        Title="СКУД"
        Width="1250"
Height="720"
MinWidth="1100"
MinHeight="650"

        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ViewNameToVisibilityConverter x:Key="UsersViewVisibilityConverter"
                                           ViewName="Users"/>

        <converters:ViewNameToVisibilityConverter x:Key="LogsViewVisibilityConverter"
                                           ViewName="Logs"/>
        <converters:VerificationIconConverter x:Key="VerificationIconConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#1F2937"
                Padding="16">

            <StackPanel>
                <TextBlock Text="СКУД"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <Button Content="Пользователи"
        Height="40"
        Margin="0 0 0 10"
        Command="{Binding LoadUsersCommand}"/>

                <Button Content="Загрузить фото"
        Height="40"
        Margin="0 0 0 10"
        Command="{Binding UploadPhotoCommand}"/>

                <Button Content="Импорт фото"
        Height="40"
        Margin="0 0 0 10"
        Command="{Binding ImportDemoPhotosCommand}"/>

                <Button Content="Журнал"
        Height="40"
        Margin="0 0 0 10"
        Command="{Binding LoadEventLogsCommand}"/>

                <Button Content="Очистить журнал"
        Height="40"
        Margin="0 0 0 10"
        Command="{Binding ClearEventLogsCommand}"/>


                <Button Content="Настройки"
        Height="40"
        Margin="0 0 0 20"/>

                <Button Content="Проверить Face ID"
        Height="40"
        Command="{Binding CheckAccessCommand}"/>

            </StackPanel>

        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            Margin="0 0 0 12">
                <Grid ClipToBounds="True">
                    <TextBlock Text="Фото сотрудника"
               Foreground="#6B7280"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                    <Image Source="{Binding SelectedUserPhoto}"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
                    <Image Source="{Binding VerificationVisualState, Converter={StaticResource VerificationIconConverter}}"
       Width="64"
       Height="64"
       HorizontalAlignment="Right"
       VerticalAlignment="Bottom"
       Margin="0 0 8 8"/>

                    <!-- Желтая полоса имитирует сканирование лица -->
                    <Rectangle x:Name="ScanLine"
               Height="8"
               Fill="#FACC15"
               Opacity="0.9"
               VerticalAlignment="Top"
               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Rectangle.RenderTransform>

                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Rectangle.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="0"
                                         To="150"
                                         Duration="0:0:1.2"
                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Grid>

            </Border>

            <Grid Grid.Row="1">
                <!-- Таблица пользователей -->
                <DataGrid ItemsSource="{Binding Users}"
              SelectedItem="{Binding SelectedGridItem}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              Visibility="{Binding CurrentView, Converter={StaticResource UsersViewVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код"
                    Binding="{Binding EmployeeCode}"
                    Width="80"/>

                        <DataGridTextColumn Header="ФИО"
                    Binding="{Binding FullName}"
                    Width="2*"/>

                        <DataGridTextColumn Header="Подразделение"
                    Binding="{Binding Department}"
                    Width="2*"/>

                        <DataGridTextColumn Header="Статус"
                    Binding="{Binding StatusView}"
                    Width="120"/>

                        <DataGridTextColumn Header="Биометрия"
                    Binding="{Binding BiometryStatus}"
                    Width="160"/>

                        <DataGridTextColumn Header="Пропуск"
                    Binding="{Binding PassStatusView}"
                    Width="110"/>

                        <DataGridTextColumn Header="Пропуск до"
                    Binding="{Binding PassExpiresAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                    Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Таблица журнала событий -->
                <DataGrid ItemsSource="{Binding EventLogs}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              Visibility="{Binding CurrentView, Converter={StaticResource LogsViewVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№"
                    Binding="{Binding EventId}"
                    Width="60"/>

                        <DataGridTextColumn Header="Время"
                    Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                    Width="160"/>

                        <DataGridTextColumn Header="Код"
                    Binding="{Binding EmployeeCode}"
                    Width="80"/>

                        <DataGridTextColumn Header="ФИО"
                    Binding="{Binding FullName}"
                    Width="2*"/>

                        <DataGridTextColumn Header="Точка доступа"
                    Binding="{Binding AccessPointName}"
                    Width="1.5*"/>

                        <DataGridTextColumn Header="Решение"
                    Binding="{Binding DecisionView}"
                    Width="150"/>

                        <DataGridTextColumn Header="Метод"
                    Binding="{Binding AuthMethodView}"
                    Width="150"/>


                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


            <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Margin="0 10 0 0"/>
        </Grid>

    </Grid>
</Window>
